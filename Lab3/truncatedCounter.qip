set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "truncatedCounter.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "truncatedCounter_bb.v"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "truncatedCounter.cmp"]
